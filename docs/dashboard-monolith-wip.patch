+// Compute the display name for a pipe-string assignment.
+// When the FW taxonomy lacks a parent ID for a conceptual group (e.g. "Insurance
+// Carriers" exists only as a name prefix on its children), FW expands the
+// assignment into the full child subtree. In that case every ID's name shares
+// a common " > "-separated prefix — that prefix IS the actual industry the AM
+// targeted, and it's what the user needs to see.
+//
+// Single-ID strings just return that ID's full name unchanged.
+function displayNameFromPipeString(pipeStr) {
+  if (!pipeStr || typeof pipeStr !== 'string') return null;
+  const names = [];
+  for (const part of pipeStr.split('|')) {
+    const id = Number(part.trim());
+    if (!id || isNaN(id)) continue;
+    const entry = INDUSTRY_BY_ID.get(id);
+    if (entry) names.push(entry.name);
+  }
+  if (names.length === 0) return null;
+  if (names.length === 1) return names[0];
+  // Find longest common " > "-separated prefix across all entries
+  const split = names.map(n => n.split(' > '));
+  const minLen = Math.min(...split.map(p => p.length));
+  const common = [];
+  for (let i = 0; i < minLen; i++) {
+    const seg = split[0][i];
+    if (split.every(p => p[i] === seg)) common.push(seg);
+    else break;
+  }
+  return common.length > 0 ? common.join(' > ') : names[0];
+}
